{
  "info": {
    "name": "Employee API (one GET endpoint)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET /api/employees",
      "item": [
        {
          "name": "Get all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?id={{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{employeeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=rahim",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "rahim"
                }
              ]
            }
          }
        },
        {
          "name": "Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?department=IT&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "department",
                  "value": "IT"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "Pagination + sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?page=0&size=5&sort=joinDate,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "joinDate,desc"
                }
              ]
            }
          }
        },
        {
          "name": "All combined",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=a&department=IT&status=ACTIVE,ON_LEAVE&joinedFrom=2022-01-01&page=0&size=5&sort=joinDate,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "a"
                },
                {
                  "key": "department",
                  "value": "IT"
                },
                {
                  "key": "status",
                  "value": "ACTIVE,ON_LEAVE"
                },
                {
                  "key": "joinedFrom",
                  "value": "2022-01-01"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "joinDate,desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get by id - not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?id=999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "999"
                }
              ]
            }
          }
        },
        {
          "name": "Invalid status (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?status=RETIRED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "RETIRED"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "POST /api/employees",
      "item": [
        {
          "name": "Create (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP-016\",\n  \"firstName\": \"Nabila\",\n  \"lastName\": \"Chowdhury\",\n  \"email\": \"nabila.chowdhury@acme.com\",\n  \"phone\": \"01812345678\",\n  \"department\": \"IT\",\n  \"designation\": \"Backend Developer\",\n  \"joinDate\": \"2026-11-01\",\n  \"salary\": 75000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('employeeId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Khan\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"12345\",\n  \"department\": \"IT\",\n  \"joinDate\": \"2030-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            }
          }
        },
        {
          "name": "Create - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP-099\",\n  \"firstName\": \"Nabila\",\n  \"lastName\": \"Chowdhury\",\n  \"email\": \"rahim.uddin@acme.com\",\n  \"phone\": \"01812345678\",\n  \"department\": \"IT\",\n  \"designation\": \"Backend Developer\",\n  \"joinDate\": \"2026-11-01\",\n  \"salary\": 75000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            }
          }
        }
      ]
    }
  ]
}